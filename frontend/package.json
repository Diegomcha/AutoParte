{
	"name": "frontend",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "react-router build",
		"dev": "NODE_OPTIONS='--import ./instrument.server.mjs' SENTRY_ENVIRONMENT=development react-router dev",
		"lint": "eslint . && prettier . --check",
		"lint:ci": "eslint . -f json > eslint-report.json",
		"lint:fix": "eslint --fix . && prettier . --write",
		"start": "NODE_ENV=production NODE_OPTIONS='--import ./instrument.server.mjs' serve build/client",
		"test": "vitest run",
		"test:cov": "vitest run --coverage",
		"typecheck": "bun run typegen && tsc",
		"typegen": "react-router typegen && openapi-typescript http://localhost:8080/api/docs -o ./app/@types/api.d.ts --root-types --root-types-no-schema-prefix"
	},
	"dependencies": {
		"@mantine/core": "^9.4.1",
		"@mantine/dates": "^9.4.1",
		"@mantine/form": "^9.3.1",
		"@mantine/hooks": "^9.3.1",
		"@mantine/nprogress": "^9.4.1",
		"@mantine/schedule": "^9.4.1",
		"@phosphor-icons/react": "^2.1.10",
		"@react-router/fs-routes": "^7.17.0",
		"@react-router/node": "^7.17.0",
		"@sentry/profiling-node": "^10.57.0",
		"@sentry/react-router": "^10.57.0",
		"@tanstack/react-query": "^5.101.2",
		"clsx": "^2.1.1",
		"dayjs": "^1.11.21",
		"i": "^0.3.7",
		"i18next": "^26.3.1",
		"i18next-browser-languagedetector": "^8.2.1",
		"i18next-http-backend": "^4.0.0",
		"isbot": "^5.1.42",
		"mantine-datatable": "^9.3.1",
		"openapi-fetch": "^0.17.0",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"react-i18next": "^17.0.8",
		"react-infinite-scroll-component": "^7.2.1",
		"react-router": "^8.3.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@eslint/json": "^2.0.0",
		"@ianvs/prettier-plugin-sort-imports": "^4.7.1",
		"@react-router/dev": "^7.17.0",
		"@tailwindcss/vite": "^4.3.1",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.1",
		"@types/node": "^24.13.1",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@vitest/coverage-v8": "4.1.8",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-react": "^7.37.5",
		"globals": "^17.6.0",
		"jsdom": "^29.1.1",
		"openapi-typescript": "^7.13.0",
		"postcss": "^8.5.15",
		"postcss-preset-mantine": "^1.18.0",
		"postcss-simple-vars": "^7.0.1",
		"prettier": "^3.8.4",
		"prettier-plugin-packagejson": "^3.0.2",
		"serve": "^14.2.6",
		"tailwindcss": "^4.3.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.61.0",
		"vite": "^8.0.16",
		"vite-plugin-devtools-json": "^1.0.0",
		"vitest": "^4.1.8"
	},
	"engines": {
		"bun": "^1.3.12"
	}
}
