{
	"name": "frontend",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "react-router build",
		"dev": "react-router dev",
		"lint": "eslint && prettier --check .",
		"lint:ci": "eslint -f json > eslint-report.json",
		"lint:fix": "eslint --fix && prettier --write .",
		"start": "serve -s build/client",
		"test": "vitest run",
		"test:cov": "vitest run --coverage",
		"typecheck": "bun run typegen && tsc",
		"typegen": "react-router typegen && openapi-typescript http://localhost:8080/api/docs -o ./app/@types/api.d.ts --root-types --root-types-no-schema-prefix"
	},
	"dependencies": {
		"@mantine/core": "^9.6.1",
		"@mantine/dates": "^9.6.1",
		"@mantine/form": "^9.6.1",
		"@mantine/hooks": "^9.6.1",
		"@mantine/notifications": "^9.6.1",
		"@mantine/nprogress": "^9.6.1",
		"@mantine/schedule": "^9.6.1",
		"@phosphor-icons/react": "^2.1.10",
		"@react-pdf/renderer": "^4.9.0",
		"@react-router/node": "^8.3.1",
		"@sentry/react-router": "^10.74.0",
		"@shivantra/react-web-camera": "^1.2.0",
		"@tanstack/react-query": "^5.102.8",
		"country-flag-emoji-polyfill": "^0.1.10",
		"dayjs": "^1.11.23",
		"i18n-iso-countries": "^7.14.0",
		"i18next": "^26.4.2",
		"i18next-browser-languagedetector": "^8.2.1",
		"i18next-resources-to-backend": "^1.2.3",
		"isbot": "^5.2.2",
		"js-cookie": "^3.0.8",
		"libphonenumber-js": "^1.13.13",
		"lodash": "^4.18.1",
		"mantine-datatable": "^9.4.0",
		"openapi-fetch": "^0.17.0",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"react-i18next": "^17.0.13",
		"react-phone-number-input": "^3.4.18",
		"react-router": "^8.3.1",
		"uuid": "^14.0.2"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@eslint/json": "^2.1.0",
		"@ianvs/prettier-plugin-sort-imports": "^4.7.1",
		"@react-router/dev": "^8.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/eslint-plugin-query": "^5.102.8",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.7",
		"@types/js-cookie": "^3.0.6",
		"@types/lodash": "^4.17.25",
		"@types/node": "^24.13.4",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitest/coverage-v8": "^5.0.0",
		"eslint": "^10.10.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-react": "^7.37.5",
		"globals": "^17.12.0",
		"jsdom": "^30.0.1",
		"openapi-typescript": "^7.13.0",
		"postcss": "^8.5.28",
		"postcss-preset-mantine": "^1.18.0",
		"postcss-simple-vars": "^7.0.1",
		"prettier": "^3.9.6",
		"prettier-plugin-packagejson": "^3.0.2",
		"serve": "^14.2.6",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.70.0",
		"vite": "^8.3.0",
		"vite-plugin-devtools-json": "^1.1.0",
		"vitest": "^5.0.0"
	},
	"engines": {
		"bun": "^1.3.12",
		"node": "^24.13.2"
	}
}
