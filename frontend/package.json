{
	"name": "frontend",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "react-router build",
		"dev": "react-router dev",
		"lint": "eslint . && prettier . --check",
		"lint:ci": "eslint . -f json > eslint-report.json",
		"lint:fix": "eslint --fix . && prettier . --write",
		"test": "vitest run",
		"test:cov": "vitest run --coverage",
		"typecheck": "bun run typegen && tsc",
		"typegen": "react-router typegen && openapi-typescript http://localhost:8080/api/docs -o ./app/@types/api.d.ts --path-params-as-types --root-types --root-types-no-schema-prefix"
	},
	"dependencies": {
		"@mantine/core": "^9.1.1",
		"@mantine/form": "^9.2.2",
		"@mantine/hooks": "^9.1.1",
		"@react-router/fs-routes": "^7.16.0",
		"@react-router/node": "7.14.0",
		"i18next": "^26.2.0",
		"i18next-browser-languagedetector": "^8.2.1",
		"i18next-http-backend": "^4.0.0",
		"isbot": "^5.1.36",
		"openapi-fetch": "^0.17.0",
		"react": "^19.2.4",
		"react-dom": "^19.2.4",
		"react-i18next": "^17.0.8",
		"react-infinite-scroll-component": "^7.2.0",
		"react-router": "7.14.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@eslint/json": "^1.2.0",
		"@ianvs/prettier-plugin-sort-imports": "^4.7.1",
		"@react-router/dev": "7.14.0",
		"@tailwindcss/postcss": "^4.3.0",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.1",
		"@types/node": "^22",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@vitest/coverage-v8": "4.1.5",
		"eslint": "^10.2.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-react": "^7.37.5",
		"globals": "^17.5.0",
		"jsdom": "^29.1.0",
		"openapi-typescript": "^7.13.0",
		"postcss": "^8.5.15",
		"postcss-preset-mantine": "^1.18.0",
		"postcss-simple-vars": "^7.0.1",
		"prettier": "^3.8.3",
		"prettier-plugin-packagejson": "^3.0.2",
		"tailwindcss": "^4.3.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.58.2",
		"vite": "^8.0.3",
		"vite-plugin-devtools-json": "^1.0.0",
		"vitest": "^4.1.5"
	},
	"engines": {
		"bun": "^1.3.12"
	}
}