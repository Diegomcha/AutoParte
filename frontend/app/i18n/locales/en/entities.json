			},
			"manualReviewEnabled": {
				"label": "Enable manual reviews",
				"description": "Allows employees to manually review traveler check-in records before they are registered on the SES platform following a self-check-in.\nIf disabled, traveler check-in records will be automatically registered on the SES platform after self-check-ins"
